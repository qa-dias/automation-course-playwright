  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "verbatimModuleSyntax": false,

    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist"
  }
}